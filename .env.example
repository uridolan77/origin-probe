# Environment example
#
# SITE_URL=
#   Public site origin used for metadataBase and absolute URLs.
#   Leave unset for local defaults.
#
# AUTHOR_URL=
#   Optional author link. Leave unset so the footer stays plain text
#   ("Built by Uri Dolan") with no hyperlink.
#
# NEXT_PUBLIC_ORIGIN_LIVE_ANALYTICS=
#   Set to "true" only after a verified production event sink is bound.
#
# NEXT_PUBLIC_ORIGIN_EVENT_INGEST_URL=
#   Absolute URL of the approved POST ingest endpoint.
#
# NEXT_PUBLIC_ORIGIN_EVENT_INGEST_TOKEN=
#   Optional bearer token required by the ingest endpoint (public build).
