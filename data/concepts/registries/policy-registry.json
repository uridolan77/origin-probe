{
  "schemaVersion": 1,
  "registryKind": "origin_site_publication_policy_registry_v1",
  "allowedPackageKinds": ["origin_site_concept_publication_v1"],
  "allowedPackageVersions": [1],
  "requiredUpstreamArtifacts": [
    "reviewedWorkspace",
    "publicationRequest",
    "derivedPlan"
  ],
  "findingTemplateVersions": [1],
  "catalogIdentityFields": [
    "conceptId",
    "slug",
    "label",
    "objectKind",
    "aliases"
  ],
  "revisionPolicy": {
    "allowSupersededInBundle": false,
    "requireSupersedesDigestWhenRevisionGt1": true,
    "rejectWithdrawnAsActive": true
  }
}
